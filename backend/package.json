{
  "name": "trustlens-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the TrustLens AI dashboard (Express + SQLite)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
