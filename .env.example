# TrustLens AI Environment Variables

# Layer 1: Google Gemini API (Client-side or Proxy)
# Optional in dev; if omitted, automatically falls back to Layer 2 and Layer 3 (Offline KB)
VITE_GEMINI_API_KEY=

# Optional: Server-side proxy URL to avoid exposing keys in client bundle (e.g. http://localhost:4001)
VITE_PROXY_URL=

# Layer 2: Free Open-Source / OpenAI-compatible endpoint (e.g. OpenRouter)
# Defaults to OpenRouter free models if URL is provided
VITE_FALLBACK_API_URL=https://openrouter.ai/api/v1/chat/completions
VITE_FALLBACK_API_KEY=
VITE_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local Ollama endpoint support (optional, e.g. llama3 or mistral)
# If set, calls http://localhost:11434/v1/chat/completions
VITE_OLLAMA_MODEL=

# Backend API server URL (if running Express backend on port 4000)
VITE_API_URL=http://localhost:4000
